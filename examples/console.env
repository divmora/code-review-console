# console.env: Divmora Code Review Console, configured with environment
# variables alone (no config file). Copy to .env for docker compose, or
# use the names in a Kubernetes Deployment, systemd unit, etc.
# `code-review-console env` lists every variable.
#
# Everything else (code hosts, models, settings, executor version and
# resources, the license) is managed in the admin panel.

# ---- Required ----
# DATABASE_URL is set by docker-compose.yml; set it yourself elsewhere.
# DATABASE_URL=postgres://console:change-me@db:5432/console?sslmode=disable
POSTGRES_PASSWORD=change-me
CODEREVIEW_CONSOLE_SECRET_KEY=          # openssl rand -base64 32; keep it safe

# ---- Admin sign-in (OIDC) ----
CODEREVIEW_CONSOLE_BASE_URL=https://review.example.com
CODEREVIEW_CONSOLE_OIDC_ISSUER=https://accounts.google.com
CODEREVIEW_CONSOLE_OIDC_CLIENT_ID=
CODEREVIEW_CONSOLE_OIDC_CLIENT_SECRET=
CODEREVIEW_CONSOLE_OIDC_ALLOWED_EMAILS=admin@example.com
# CODEREVIEW_CONSOLE_OIDC_ALLOWED_DOMAINS=example.com     # needs a license with sso_rules
# CODEREVIEW_CONSOLE_COOKIE_SECRET=                      # 32+ random characters, for several replicas
# CODEREVIEW_CONSOLE_TRUSTED_PROXIES=10.0.0.0/8          # the load balancer in front, to record client IPs

# ---- Where reviews run ----
# local (default): the codereview CLI bundled in the console image.
# docker: mount /var/run/docker.sock. kubernetes: each review is a Job.
# CODEREVIEW_CONSOLE_EXECUTOR=kubernetes
# CODEREVIEW_CONSOLE_IMAGE=ghcr.io/divmora/code-review-bot:0.4.1
# CODEREVIEW_CONSOLE_KUBE_NAMESPACE=code-review
# CODEREVIEW_CONSOLE_KUBE_SERVICE_ACCOUNT=               # for IRSA / workload identity (e.g. Bedrock)

# ---- Model keys ----
# A model profile in the admin panel names the variable holding its key.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
